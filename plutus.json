    "stream/types/StreamDatum": {
      "title": "StreamDatum",
      "description": "Written once at lock time. A claim reproduces it verbatim; a stop replaces\n it with `settle(datum, c)` (see `stream/stream.ak`). Times are POSIX ms.",
